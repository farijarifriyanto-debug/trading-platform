# Production operator profile for the accepted Binance USD-M Futures boundary.
# Copy to ~/.config/trading-platform/binance-futures.env with mode 0600.
# Insert secrets only in the local copy; never commit them.

TRADING_DATA_DIR=/home/botadmin/.local/state/trading-platform
TRADING_AUDIT_PATH=/home/botadmin/.local/state/trading-platform/audit.jsonl
TRADING_REQUIRE_AUTH=1
TRADING_API_KEY=replace-with-a-long-random-secret
TRADING_MAX_BODY_BYTES=2097152
TRADING_MUTATION_RATE_PER_MINUTE=30

TRADING_LIVE_ENABLED=1
TRADING_LIVE_EXCHANGE=binance
TRADING_LIVE_MARKET_TYPE=future
TRADING_LIVE_ALLOWED_SYMBOLS=BTC/USDT:USDT
TRADING_LIVE_MAX_ORDER_NOTIONAL=100
TRADING_LIVE_MAX_POSITION_NOTIONAL=100
TRADING_LIVE_MAX_DAILY_NOTIONAL=200
TRADING_LIVE_MAX_QUOTE_AGE_MS=15000
TRADING_LIVE_ARM_TTL_SECONDS=60
TRADING_LIVE_PREFLIGHT_MAX_AGE_SECONDS=180
TRADING_LIVE_ONE_SHOT_ARM=1

# Required secrets in the local 0600 copy:
# TRADING_LIVE_EXCHANGE_API_KEY=
# TRADING_LIVE_EXCHANGE_SECRET=

# Operator CLI/API remain host-local by default.
TRADING_LIVE_API_URL=http://127.0.0.1:48070
