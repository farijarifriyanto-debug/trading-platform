[Unit]
Description=Trading Platform API (paper/research only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botadmin
Group=botadmin
WorkingDirectory=/opt/trading-platform/current
EnvironmentFile=/etc/trading-platform.env
ExecStart=/usr/bin/env /opt/trading-platform/venv/bin/uvicorn trading_platform.api:app --host 127.0.0.1 --port 48070 --workers 1
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/trading-platform
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
