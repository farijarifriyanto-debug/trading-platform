# Copy to /etc/trading-platform.env with mode 0600.
TRADING_DATA_DIR=/var/lib/trading-platform
TRADING_AUDIT_PATH=/var/lib/trading-platform/paper-audit.jsonl
TRADING_REQUIRE_AUTH=1
TRADING_API_KEY=replace-with-a-long-random-secret
TRADING_MAX_BODY_BYTES=2097152
TRADING_MUTATION_RATE_PER_MINUTE=120

# Phase 8 live execution is fail-closed. Keep disabled until a separately approved canary.
TRADING_LIVE_ENABLED=0
TRADING_LIVE_EXCHANGE=kraken
TRADING_LIVE_MARKET_TYPE=spot
TRADING_LIVE_ALLOWED_SYMBOLS=BTC/USD
TRADING_LIVE_MAX_ORDER_NOTIONAL=100
TRADING_LIVE_MAX_POSITION_NOTIONAL=500
TRADING_LIVE_MAX_DAILY_NOTIONAL=500
TRADING_LIVE_MAX_QUOTE_AGE_MS=15000
TRADING_LIVE_ARM_TTL_SECONDS=300
TRADING_LIVE_PREFLIGHT_MAX_AGE_SECONDS=300
TRADING_LIVE_ONE_SHOT_ARM=1
# Set these only in the real 0600 environment file; never commit credentials:
# TRADING_LIVE_EXCHANGE_API_KEY=
# TRADING_LIVE_EXCHANGE_SECRET=
# TRADING_LIVE_EXCHANGE_PASSWORD=

NAUTILUS_WORKER_PYTHON=/home/botadmin/.venvs/trading-nautilus/bin/python
LEAN_CLI=/home/botadmin/.venvs/trading-lean/bin/lean
ML_WORKER_PYTHON=/home/botadmin/.venvs/trading-ml/bin/python
FINRLX_WORKER_PYTHON=/home/botadmin/.venvs/trading-finrlx/bin/python
FINRLX_SOURCE=/home/botadmin/vendor/FinRL-Trading
