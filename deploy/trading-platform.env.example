# Copy to /etc/trading-platform.env with mode 0600.
TRADING_DATA_DIR=/var/lib/trading-platform
TRADING_AUDIT_PATH=/var/lib/trading-platform/paper-audit.jsonl
TRADING_REQUIRE_AUTH=1
TRADING_API_KEY=replace-with-a-long-random-secret
TRADING_MAX_BODY_BYTES=2097152
TRADING_MUTATION_RATE_PER_MINUTE=120

NAUTILUS_WORKER_PYTHON=/home/botadmin/.venvs/trading-nautilus/bin/python
LEAN_CLI=/home/botadmin/.venvs/trading-lean/bin/lean
ML_WORKER_PYTHON=/home/botadmin/.venvs/trading-ml/bin/python
FINRLX_WORKER_PYTHON=/home/botadmin/.venvs/trading-finrlx/bin/python
FINRLX_SOURCE=/home/botadmin/vendor/FinRL-Trading
